# Skopíruj do .env.local a vyplň hodnoty.
# Na webe (Vercel) tieto premenné nastav v Dashboard → Project → Settings → Environment Variables.
# Kľúče sa na serveri nikdy neposielajú do prehliadača – ostávajú skryté.

# Gemini (rozprávky)
GOOGLE_GEMINI_API_KEY=

# Voliteľne: iný model (predvolené gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Supabase — rozprávky (hlavná stránka / API generate-story)
# Buď tieto dve (spätná kompatibilita), alebo výslovne STORY_* nižšie.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Voliteľne výslovne len pre rozprávky (prepíšu URL/KEY vyššie pre story klienta):
# NEXT_PUBLIC_SUPABASE_STORY_URL=
# NEXT_PUBLIC_SUPABASE_STORY_ANON_KEY=

# Supabase — druhý projekt len pre Learning progress (useProgress / tabuľka learning_progress)
NEXT_PUBLIC_SUPABASE_LEARNING_URL=
NEXT_PUBLIC_SUPABASE_LEARNING_ANON_KEY=
# Anon kľúč z rovnakého projektu ako LEARNING_URL (Settings → API → anon public JWT).

# Google TTS (lepší hlas) – buď API kľúč, alebo service account
# GOOGLE_TTS_API_KEY=
# alebo:
# GOOGLE_TTS_CLIENT_EMAIL=
# GOOGLE_TTS_PRIVATE_KEY=
# GOOGLE_TTS_VOICE=sk-SK-Wavenet-A
